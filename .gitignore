# Zig build outputs
.zig-cache/
zig-out/
.cache/

# Local toolchain and reference downloads (regenerated by tools/bootstrap.sh)
.tools/

# devenv local environment
.devenv/
.direnv/

# Local UI snapshot / benchmark output
snapshots-local/
*.tmp
*.log
.DS_Store

# Local server journals
/events.ndjson

# Python caches only for optional developer tooling (not required by the build)
__pycache__/
*.py[cod]
.pytest_cache/

# Default local snapshot output
/xsprof-snapshot.png

# Local release artifacts
/dist/

# Local VM verification lab state (tools/vm_lab.sh): scoped podman HOME/XDG
# dirs, machine caches and staging live here; evidence bundles live under
# dist/vm/. Never commit either.
/.vm/

# Local Nix evaluation caches (sandbox-friendly)
.nix-cache/
.nix-tmp/
