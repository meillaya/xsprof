{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsprof.dev/schemas/metrics.v1.schema.json",
  "title": "xsprof scheduler metrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["cpus", "faults_major", "faults_minor", "first_us", "host_mutation", "last_us", "lost", "migrations", "quantiles", "schema", "switches", "tasks", "wakeups"],
  "properties": {
    "cpus": { "type": "array" },
    "faults_major": { "type": "integer" },
    "faults_minor": { "type": "integer" },
    "first_us": { "type": "integer" },
    "host_mutation": { "const": false },
    "last_us": { "type": "integer" },
    "lost": { "type": "integer" },
    "migrations": { "type": "integer" },
    "quantiles": { "type": "object" },
    "schema": { "const": "xsprof/metrics/v1" },
    "switches": { "type": "integer" },
    "tasks": { "type": "array" },
    "wakeups": { "type": "integer" }
  }
}
