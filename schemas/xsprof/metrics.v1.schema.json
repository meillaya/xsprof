{
  "$id": "https://xsprof.dev/schemas/metrics.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cpus": {
      "type": "array"
    },
    "events": {
      "type": "integer"
    },
    "faults_major": {
      "type": "integer"
    },
    "faults_minor": {
      "type": "integer"
    },
    "first_us": {
      "type": "integer"
    },
    "host_mutation": {
      "const": false
    },
    "last_us": {
      "type": "integer"
    },
    "lost": {
      "type": "integer"
    },
    "migrations": {
      "type": "integer"
    },
    "quantiles": {
      "type": "object"
    },
    "schema": {
      "const": "xsprof/metrics/v1"
    },
    "self_unnecessary_wakeups": {
      "type": "integer"
    },
    "self_wakeups": {
      "type": "integer"
    },
    "switches": {
      "type": "integer"
    },
    "tasks": {
      "type": "array"
    },
    "unnecessary_wakeups": {
      "type": "integer"
    },
    "unresolved_wakeups": {
      "type": "integer"
    },
    "wakeups": {
      "type": "integer"
    },
    "out_of_order": {
      "type": "integer",
      "minimum": 0
    },
    "pairs_truncated": {
      "type": "boolean"
    },
    "wakeup_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "p95_wait_us",
          "waker_comm",
          "waker_pid",
          "woken_comm",
          "woken_pid"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "p95_wait_us": {
            "type": "integer",
            "minimum": 0
          },
          "waker_comm": {
            "type": "string"
          },
          "waker_pid": {
            "type": "integer"
          },
          "woken_comm": {
            "type": "string"
          },
          "woken_pid": {
            "type": "integer"
          }
        }
      }
    }
  },
  "required": [
    "cpus",
    "events",
    "faults_major",
    "faults_minor",
    "first_us",
    "host_mutation",
    "last_us",
    "lost",
    "migrations",
    "quantiles",
    "schema",
    "self_unnecessary_wakeups",
    "self_wakeups",
    "switches",
    "tasks",
    "unnecessary_wakeups",
    "unresolved_wakeups",
    "wakeups",
    "out_of_order",
    "pairs_truncated",
    "wakeup_pairs"
  ],
  "title": "xsprof scheduler metrics",
  "type": "object"
}
