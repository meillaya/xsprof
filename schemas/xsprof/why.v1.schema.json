{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsprof.dev/schemas/why.v1.schema.json",
  "title": "xsprof why report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cpus",
    "events",
    "findings",
    "host_mutation",
    "lost",
    "out_of_order",
    "pairs",
    "rules",
    "schema",
    "source",
    "tasks",
    "window_ms",
    "malformed"
  ],
  "properties": {
    "cpus": {
      "type": "array"
    },
    "events": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array"
    },
    "host_mutation": {
      "const": false
    },
    "latency": {
      "additionalProperties": false,
      "properties": {
        "causes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "minimum": 0,
                "type": "integer"
              },
              "reason": {
                "enum": [
                  "dead",
                  "idle",
                  "interruptible",
                  "other",
                  "parked",
                  "preempted",
                  "stopped",
                  "traced",
                  "uninterruptible",
                  "unknown",
                  "zombie"
                ]
              },
              "total_us": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "count",
              "reason",
              "total_us"
            ],
            "type": "object"
          },
          "maxItems": 11,
          "type": "array"
        },
        "chain_cycles_cut": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_depth_cut": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_edges": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_overflow": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_roots": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_too_many_tasks": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_truncated": {
          "type": "boolean"
        },
        "chains": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "minimum": 0,
                "type": "integer"
              },
              "depth": {
                "minimum": 0,
                "type": "integer"
              },
              "leaf_comm": {
                "type": "string"
              },
              "leaf_pid": {
                "type": "integer"
              },
              "p95_wait_us": {
                "minimum": 0,
                "type": "integer"
              },
              "root_pid": {
                "type": "integer"
              },
              "total_wait_us": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "count",
              "depth",
              "leaf_comm",
              "leaf_pid",
              "p95_wait_us",
              "root_pid",
              "total_wait_us"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "type": "array"
        },
        "offcpu_samples": {
          "minimum": 0,
          "type": "integer"
        },
        "offcpu_unresolved": {
          "minimum": 0,
          "type": "integer"
        },
        "preempt_p95_us": {
          "minimum": 0,
          "type": "integer"
        },
        "preempt_unresolved": {
          "minimum": 0,
          "type": "integer"
        },
        "preemptions": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "causes",
        "chain_cycles_cut",
        "chain_depth_cut",
        "chain_edges",
        "chain_overflow",
        "chain_roots",
        "chain_too_many_tasks",
        "chain_truncated",
        "chains",
        "offcpu_samples",
        "offcpu_unresolved",
        "preempt_p95_us",
        "preempt_unresolved",
        "preemptions"
      ],
      "type": "object"
    },
    "lost": {
      "type": "integer",
      "minimum": 0
    },
    "out_of_order": {
      "type": "integer",
      "minimum": 0
    },
    "pairs": {
      "type": "array"
    },
    "rules": {
      "type": "array"
    },
    "schema": {
      "const": "xsprof/why/v1"
    },
    "source": {
      "type": "string"
    },
    "tasks": {
      "type": "array"
    },
    "window_ms": {
      "type": "integer",
      "minimum": 0
    },
    "malformed": {
      "type": "integer",
      "minimum": 0
    }
  }
}
