{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsprof.dev/schemas/lab-scenario.v1.schema.json",
  "title": "xsprof GUI lab scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "source", "steps"],
  "properties": {
    "assertions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "op", "value"],
        "properties": {
          "metric": {
            "enum": ["events", "switches", "wakeups", "migrations", "faults", "lost", "cpu_count", "screen", "indicator"]
          },
          "op": { "enum": ["eq", "ne", "gte", "lte"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "schema": { "const": "xsprof/lab-scenario/v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["fixture", "journal"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "at_ms"],
        "properties": {
          "action": {
            "enum": ["screen", "filter", "select", "transport", "snapshot", "export_file"]
          },
          "at_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
          "value": { "type": "string", "maxLength": 1024 }
        }
      }
    }
  }
}
