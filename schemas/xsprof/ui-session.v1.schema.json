{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsprof.dev/schemas/ui-session.v1.schema.json",
  "title": "xsprof web session metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_count",
    "host_mutation",
    "offset",
    "schema",
    "source"
  ],
  "properties": {
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "host_mutation": {
      "const": false
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "schema": {
      "const": "xsprof/ui-session/v1"
    },
    "source": {
      "enum": [
        "live",
        "replay"
      ]
    }
  }
}
