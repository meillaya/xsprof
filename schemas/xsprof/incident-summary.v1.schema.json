{
  "$id": "https://xsprof.dev/schemas/incident-summary.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": false,
      "properties": {
        "report": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "trace": {
          "type": "string"
        },
        "window": {
          "type": "string"
        }
      },
      "required": [
        "report",
        "summary",
        "trace",
        "window"
      ],
      "type": "object"
    },
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "reason",
          "state"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "events": {
      "type": "integer"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "enum": [
              "measured",
              "heuristic"
            ]
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "recommendations": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "detail": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "rationale": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "detail",
                "rationale"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "confidence",
          "summary",
          "evidence",
          "recommendations"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "host_mutation": {
      "const": false
    },
    "latency": {
      "additionalProperties": false,
      "properties": {
        "causes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "minimum": 0,
                "type": "integer"
              },
              "reason": {
                "enum": [
                  "dead",
                  "idle",
                  "interruptible",
                  "other",
                  "parked",
                  "preempted",
                  "stopped",
                  "traced",
                  "uninterruptible",
                  "unknown",
                  "zombie"
                ]
              },
              "total_us": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "count",
              "reason",
              "total_us"
            ],
            "type": "object"
          },
          "maxItems": 11,
          "type": "array"
        },
        "chain_cycles_cut": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_depth_cut": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_edges": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_overflow": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_roots": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_too_many_tasks": {
          "minimum": 0,
          "type": "integer"
        },
        "chain_truncated": {
          "type": "boolean"
        },
        "chains": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "minimum": 0,
                "type": "integer"
              },
              "depth": {
                "minimum": 0,
                "type": "integer"
              },
              "leaf_comm": {
                "type": "string"
              },
              "leaf_pid": {
                "type": "integer"
              },
              "p95_wait_us": {
                "minimum": 0,
                "type": "integer"
              },
              "root_pid": {
                "type": "integer"
              },
              "total_wait_us": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "count",
              "depth",
              "leaf_comm",
              "leaf_pid",
              "p95_wait_us",
              "root_pid",
              "total_wait_us"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "type": "array"
        },
        "offcpu_samples": {
          "minimum": 0,
          "type": "integer"
        },
        "offcpu_unresolved": {
          "minimum": 0,
          "type": "integer"
        },
        "preempt_p95_us": {
          "minimum": 0,
          "type": "integer"
        },
        "preempt_unresolved": {
          "minimum": 0,
          "type": "integer"
        },
        "preemptions": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "causes",
        "chain_cycles_cut",
        "chain_depth_cut",
        "chain_edges",
        "chain_overflow",
        "chain_roots",
        "chain_too_many_tasks",
        "chain_truncated",
        "chains",
        "offcpu_samples",
        "offcpu_unresolved",
        "preempt_p95_us",
        "preempt_unresolved",
        "preemptions"
      ],
      "type": "object"
    },
    "loss": {
      "additionalProperties": false,
      "properties": {
        "lost": {
          "type": "integer"
        },
        "retention_trimmed": {
          "type": "boolean"
        }
      },
      "required": [
        "lost",
        "retention_trimmed"
      ],
      "type": "object"
    },
    "loss_by_kind": {
      "additionalProperties": false,
      "properties": {
        "capture_corrupt_segment": {
          "minimum": 0,
          "type": "integer"
        },
        "capture_invalid_segment_path": {
          "minimum": 0,
          "type": "integer"
        },
        "capture_missing_segment": {
          "minimum": 0,
          "type": "integer"
        },
        "capture_segment_unreadable": {
          "minimum": 0,
          "type": "integer"
        },
        "capture_truncated": {
          "minimum": 0,
          "type": "integer"
        },
        "capture_truncated_tail": {
          "minimum": 0,
          "type": "integer"
        },
        "capture_unknown_segment_codec": {
          "minimum": 0,
          "type": "integer"
        },
        "capture_unsupported_segment": {
          "minimum": 0,
          "type": "integer"
        },
        "retention_loss": {
          "minimum": 0,
          "type": "integer"
        },
        "sample_loss": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "requested_ms": {
      "type": "integer"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "enum": [
              "finding",
              "clear",
              "skip"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "xsprof/incident-summary/v1"
    },
    "self": {
      "additionalProperties": false,
      "properties": {
        "share": {
          "type": "number"
        },
        "switches": {
          "type": "integer"
        }
      },
      "required": [
        "share",
        "switches"
      ],
      "type": "object"
    },
    "signals": {
      "additionalProperties": false,
      "properties": {
        "allocator": {
          "type": "boolean"
        },
        "cpu_topology": {
          "type": "boolean"
        },
        "lock_contention": {
          "type": "boolean"
        },
        "numa_fault": {
          "type": "boolean"
        },
        "page_fault": {
          "type": "boolean"
        },
        "pmu_hitm": {
          "type": "boolean"
        },
        "priority_inversion": {
          "type": "boolean"
        },
        "sched_migrate": {
          "type": "boolean"
        },
        "sched_switch": {
          "type": "boolean"
        },
        "sched_wakeup": {
          "type": "boolean"
        }
      },
      "required": [
        "allocator",
        "cpu_topology",
        "lock_contention",
        "numa_fault",
        "page_fault",
        "pmu_hitm",
        "priority_inversion",
        "sched_migrate",
        "sched_switch",
        "sched_wakeup"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string"
        },
        "window": {
          "type": "string"
        }
      },
      "required": [
        "dir",
        "window"
      ],
      "type": "object"
    },
    "tasks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "comm": {
            "type": "string"
          },
          "migrations": {
            "type": "integer"
          },
          "pid": {
            "type": "integer"
          },
          "switches": {
            "type": "integer"
          },
          "wait_p95_us": {
            "type": "integer"
          }
        },
        "required": [
          "comm",
          "migrations",
          "pid",
          "switches",
          "wait_p95_us"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "trace": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "events",
        "truncated"
      ],
      "type": "object"
    },
    "window": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "type": "integer"
        },
        "first_us": {
          "type": "integer"
        },
        "last_us": {
          "type": "integer"
        },
        "retained_ms": {
          "type": "integer"
        },
        "trimmed": {
          "type": "boolean"
        }
      },
      "required": [
        "duration_ms",
        "first_us",
        "last_us",
        "retained_ms",
        "trimmed"
      ],
      "type": "object"
    }
  },
  "required": [
    "artifacts",
    "capabilities",
    "events",
    "findings",
    "host_mutation",
    "loss",
    "requested_ms",
    "rules",
    "schema",
    "self",
    "signals",
    "source",
    "tasks",
    "trace",
    "window"
  ],
  "title": "xsprof incident summary v1",
  "type": "object"
}
