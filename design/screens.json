    {
      "id": "capture",
      "title": "Capture",
      "route": "#capture",
      "navKey": "5",
      "purpose": "Read-only recorder status, retention budget, segments, exact CLI commands, and refused verbs.",
      "head": {
        "eyebrow": "Read-only status · no mutation controls",
        "title": "Capture",
        "note": "Attach a recorder in a terminal. This view cannot start, stop, or alter a capture."
      },
      "regions": [
        {
          "id": "capture-col-left",
          "children": [
            {
              "id": "recorder-state",
              "index": "01",
              "title": "Recorder state",
              "meta": "REPLAY",
              "rows": [
                "Source REPLAY",
                "Recorder not attached",
                "Manifest manifest.json · replay fixture",
                "Window 5 m 00 s · excerpt 13.970 s",
                "Host vm-lab-04 · 6.8.0-40-generic",
                "host_mutation false (pass)"
              ]
            },
            {
              "id": "retention",
              "index": "02",
              "title": "Retention budget",
              "meta": "412 MiB / 2 GiB",
              "content": "6px meter at 20%, 0 → 2 GiB scale, oldest closed segments drop first, retention_loss marker",
              "note": "Each drop writes an explicit retention_loss marker — never a silent gap."
            },
            {
              "id": "segments",
              "index": "03",
              "title": "Segments",
              "meta": "6 segments",
              "rows": "s-0007..s-0002; 14.2/16.0 MiB; windows; OPEN/CLOSED/LOSS 1 tags"
            }
          ]
        },
        {
          "id": "capture-col-right",
          "children": [
            {
              "id": "commands",
              "index": "04",
              "title": "Run it yourself",
              "meta": "copy exact commands",
              "commands": [
                "xsprof record --duration 2000 --output session.ndjson",
                "xsprof daemon --foreground --dir /var/lib/xsprof --retain 10m --max-bytes 2G",
                "xsprof capture --last 5m --dir /var/lib/xsprof --out incident.ndjson",
                "xsprof watch --dir /var/lib/xsprof --window 30s"
              ]
            },
            {
              "id": "safety",
              "index": "05",
              "title": "Refused by design",
              "meta": "host_mutation=false",
              "note": "These verbs fail closed. The profiler does not write /proc or /sys, elevate privileges, enable BPF, or auto-apply advisor recommendations.",
              "refused": [
                "load",
                "attach",
                "enable",
                "mutate",
                "apply",
                "sched-ext-attach",
                "setaffinity",
                "setpriority",
                "bind"
              ],
              "privacy": "Runtime samples never include argv, environment variables, secrets, or tokens."
            }
          ]
        }
      ],
      "states": [
        {
          "id": "ready",
          "behavior": "replay fixture status, 6 segments, 20% retention"
        },
        {
          "id": "journal-loaded",
          "behavior": "Recorder = journal loaded (offline); manifest = file name; no segment index if single file"
        },
        {
          "id": "no-retention",
          "behavior": "meta not available; scale reads —; meter 0%"
        },
        {
          "id": "no-segments",
          "behavior": "panel note: single extracted file has no rotation history"
        },
        {
          "id": "copy",
          "behavior": "Copy button writes command; success toast; failure toast if clipboard unavailable"
        }
      ],
      "interactions": [
        "Copy command buttons",
        "no capture-control controls by design"
      ]
    }
  ],
  "overlays": [
    {
      "id": "command-palette",
      "component": "dialog.palette",
      "trigger": [
        "⌘K/Ctrl K",
        "palette button"
      ],
      "width": 560,
      "marginTop": "14vh",
      "content": [
        "input placeholder Jump to screen, switch theme, open journal…",
        "list of 17 commands grouped screen/action/theme",
        "footer ↑↓ move · enter run"
      ],
      "states": [
        "open",
        "filtered",
        "no matches",
        "keyboard active"
      ]
    },
    {
      "id": "appearance",
      "component": "dialog.themes",
      "trigger": [
        "w",
        "theme button",
        "palette action"
      ],
      "width": 620,
      "marginTop": "6vh",
      "content": [
