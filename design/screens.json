  "stateMatrix": {
    "requiredProgramStates": [
      "loading",
      "empty",
      "ready",
      "skip",
      "refuse",
      "loss",
      "stale",
      "malformed"
    ],
    "implementedInPrototype": {
      "ready": true,
      "empty": true,
      "skip": true,
      "refuse": true,
      "loss": true,
      "malformed": "partial (toast + skipped lines)",
      "loading": false,
      "stale": "represented only as REPLAY · no live tail"
    },
    "policy": "A missing signal is never displayed as zero. Loss and refusal rows are explicit. READY is scoped to the gate that produced it."
  }
