{
  "$schema": "xsprof/ui-spec/v1",
  "version": 2,
  "status": "canonical",
  "meaning": "The single deterministic rendering and interaction contract for every native xsprof surface. The frozen HTML prototype is design input only; reference pixel diffs are advisory. CPU is the canonical raster; Metal and OpenGL consume the same draw list and text atlas.",
  "design_source": {
    "prototype": "design/index.html",
    "sha256": "0823328b3261b89ce2d8c2af53ebc61adfedd49f19706239e437b7fdb6a3de62",
    "tokens": [
      "design/tokens.json",
      "design/palettes.json"
    ],
    "screens": "design/screens.json",
    "flows": "design/flows.json",
    "keybindings": "design/keybindings.json"
  },
  "render": {
    "coordinate_space": "physical-pixels",
    "device_scale": 1,
    "draw_list": "xsui/instance-v1",
    "backends": [
      "cpu",
      "metal",
      "gl"
    ],
    "canonical_backend": "cpu",
    "blend": "sRGB source-over, 8-bit",
    "geometry": "the same fractional draw list is consumed by every native backend",
    "platform_fonts": false,
    "text_atlas": {
      "file": "lib/xsui/assets/fonts/chromium_text_atlas.bin",
      "schema": "xsprof/chromium-text-atlas/v1",
      "sha256": "84008da0e63e67b1516de44af3d4bd498df57149a2e2e1c537a1fb7d3f4a02a5",
      "bytes": 4386352,
      "atlas_size": 4096,
      "phase_grid": {
        "x": [
          0,
          0.25,
          0.5,
          0.75
        ],
        "y": [
          0,
          0.5
        ]
      },
      "fallback": "staged TTF for unavailable glyphs/phases"
    }
  },
  "canvas": {
    "reference": {
      "width": 1440,
      "height": 900
    },
    "native": {
      "width": 1280,
      "height": 720
    },
    "background": "bg"
  },
  "breakpoints": [
    {
      "id": "wide",
      "min_width": 1321,
      "grid_3_columns": 3,
      "rail": "side",
      "keybar": true
    },
    {
      "id": "compact",
      "max_width": 1320,
      "grid_3_columns": 2,
      "rail": "side",
      "keybar": true
    },
    {
      "id": "stacked",
      "max_width": 1140,
      "rail": "side",
      "keybar": true,
      "timeline": "stacked",
      "events": "stacked"
    },
    {
      "id": "bottom-rail",
      "max_width": 1024,
      "rail": "bottom",
      "keybar": false,
      "grid_capture": 1,
      "advisor": 1
    },
    {
      "id": "compact-topbar",
      "max_width": 780,
      "rail": "bottom",
      "keybar": false,
      "grid_3": 1,
      "grid_capture": 1,
      "brief_columns": 2
    },
    {
      "id": "phone",
      "max_width": 420,
      "rail": "bottom",
      "keybar": false,
      "theme_grid": 1
    }
  ],
  "shell": {
    "topbar_h": 52,
    "rail_w": 92,
    "keybar_h": 30,
    "stage_pad_top": 20,
    "stage_pad_x": 24,
    "stage_pad_bottom": 22,
    "rail_item_h": 63.75,
    "radius": 5
  },
  "screens": [
    "home",
    "overview",
    "timeline",
    "advisor",
    "events",
    "capture",
    "audit",
    "settings"
  ],
  "overlays": [
    "palette",
    "appearance",
    "help",
    "picker",
    "confirm",
    "onboarding",
    "toast"
  ],
  "text_roles": [
    {
      "id": "wordmark",
      "size": 14,
      "weight": "bold",
      "tracking": -0.14
    },
    {
      "id": "screen-title",
      "size": 20,
      "weight": "bold",
      "tracking": -0.4
    },
    {
      "id": "panel-title",
      "size": 10.5,
      "weight": "bold",
      "tracking": 1.05
    },
    {
      "id": "eyebrow",
      "size": 10.5,
      "weight": "regular",
      "tracking": 1.47
    },
    {
      "id": "body",
      "size": 11,
      "weight": "regular"
    },
    {
      "id": "meta",
      "size": 10.5,
      "weight": "regular"
    },
    {
      "id": "micro",
      "size": 9.5,
      "weight": "regular"
    },
    {
      "id": "stat-value",
      "size": 27,
      "weight": "bold",
      "tracking": -0.8
    },
    {
      "id": "stat-lead",
      "size": 34,
      "weight": "bold",
      "tracking": -0.8
    }
  ],
  "components": {
    "panel": {
      "border": 1,
      "radius": 5,
      "head_h": 36,
      "head_pad_top": 9,
      "head_pad_x": 14,
      "body_pad_x": 14
    },
    "chip": {
      "border": 1,
      "radius": 3,
      "pad_x": 7,
      "pad_y": 3,
      "gap": 5
    },
    "keycap": {
      "border": 1,
      "radius": 3,
      "pad_x": 4,
      "line_height": 1.5,
      "font_size": 9.5
    },
    "badge": {
      "border": 1,
      "radius": 3,
      "pad_x": 5,
      "pad_y": 1,
      "gap": 4,
      "font_size": 9.5
    },
    "button": {
      "border": 1,
      "radius": 4,
      "h": 28
    }
  },
  "interaction": {
    "state_machine": "src/app/design/state.zig",
    "screens_switch": "0 home, 1..5 analysis, 6 audit, 7 settings",
    "palette": "meta/ctrl+k",
    "appearance": "w",
    "help": "?",
    "filter": "/",
    "playback": "space",
    "brush": "pointer drag on timeline plot (>4px, >20ms) zooms; minimum 300ms span",
    "focus": {
      "model": "Canvas hit ids in layout order; visible 2px ring with 2px offset",
      "tab": "Tab/Shift+Tab cycle valid targets; dialogs trap and restore trigger",
      "activation": "Enter/Space activate the focused target; palette input keeps text keys",
      "rail": "Arrow Up/Down move between screen tabs while rail is focused",
      "skip": "native uses Tab traversal; dialogs trap focus and restore the trigger"
    },
    "clipboard": {
      "request": "bounded UTF-8 request emitted by App; native surfaces consume exactly once",
      "macos": "NSPasteboard public.utf8-plain-text",
      "linux": "X11 CLIPBOARD owner + SelectionRequest/TARGETS handler (compile-verified)"
    },
    "responsive": {
      "1320": "two-column grid-3",
      "1140": "compact brand; stacked timeline/events",
      "1024": "bottom rail; no keybar; single capture/advisor; full-width grid",
      "780": "compact topbar; one-column overview; mobile thread/ledger rows",
      "420": "hidden source chip; single-column theme grid; 22/28px stat values"
    },
    "settings": "meta/ctrl+,"
  },
  "data": {
    "source": "journal, native live capture, recorder manifest",
    "read_only": true,
    "host_mutation": false,
    "uncollected": "explicit SKIP/uncollected; never fabricated zero"
  },
  "acceptance": {
    "cross_surface": {
      "cpu_vs_metal": {
        "mae_max": 4.0,
        "over24_max": 3.0
      },
      "cpu_vs_gl": {
        "mae_max": 4.0,
        "over24_max": 3.0,
        "routes": [
          "home",
          "overview"
        ]
      }
    },
    "reference": {
      "role": "advisory design comparison",
      "pixel_gate": false
    },
    "layout": {
      "text_origin_tolerance_px": 0.01,
      "box_edge_tolerance_px": 1.0
    }
  },
  "extension": {
    "status": "proposed",
    "prototypeUpdated": false,
    "analysisScreens": [
      "overview",
      "timeline",
      "advisor",
      "events",
      "capture"
    ],
    "reason": "Product shell v2 adds Home/Audit/Settings routes and picker/confirm/onboarding overlays. The pinned design/index.html prototype remains the source for the five analysis screens; the extension is specified in design/product-shell.md and screens.json/flows.json until the prototype is updated."
  },
  "platforms": [
    "macos",
    "linux",
    "snapshot"
  ]
}
