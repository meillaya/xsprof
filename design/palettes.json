  },
  "defaultTheme": "dark",
  "attribute": "data-theme",
  "semanticRoles": {
    "surface": [
      "bg",
      "panel",
      "raised",
      "raised-2",
      "field"
    ],
    "ink": [
      "text",
      "muted",
      "dim",
      "faint"
    ],
    "stroke": [
      "line",
      "line-strong"
    ],
    "status": [
      "live",
      "pass",
      "skip",
      "refuse",
      "pending",
      "vm"
    ],
    "tint": [
      "tint-live",
      "tint-refuse",
      "tint-skip",
      "tint-pass"
    ],
    "lane": [
      "lane-1",
      "lane-2",
      "lane-3",
      "lane-4",
      "lane-5",
      "lane-6",
      "lane-7",
      "lane-8",
      "lane-9",
      "lane-idle",
      "lane-grid"
    ],
    "focus": [
      "focus"
    ]
  },
  "stateContract": {
    "ready": "pass + READY label + ● glyph",
    "degraded": "skip + DEGRADED label + ◐ glyph",
    "skip": "skip + SKIP label + ○ glyph",
    "refuse": "refuse + REFUSE label + ■ glyph",
    "clear": "pass + CLEAR label + ● glyph",
    "warning": "skip + WARNING label + ◐ glyph",
    "info": "live + INFO label + ● glyph",
    "live": "live + live label",
    "vm": "vm + VM label",
    "loss": "refuse + LOSS label + ■ glyph; backgrounds use tint-refuse",
    "rule": "Every semantic color is paired with a label or glyph; color is never the only signal."
  },
  "colorMixRecipes": [
    {
      "id": "chip-source-border",
      "space": "srgb",
      "from": "live",
      "weight": 0.4,
      "to": "line",
      "usage": "SOURCE chip border",
      "derivedPerTheme": true
    },
    {
      "id": "chip-journal-border",
      "space": "srgb",
      "from": "pass",
      "weight": 0.42,
      "to": "line",
      "usage": "JOURNAL source chip border",
      "derivedPerTheme": true
    },
    {
      "id": "chip-loss-border",
      "space": "srgb",
      "from": "refuse",
      "weight": 0.4,
      "to": "line",
      "usage": "loss chip border",
      "derivedPerTheme": true
    },
    {
      "id": "control-pressed-border",
      "space": "srgb",
      "from": "live",
      "weight": 0.45,
      "to": "line",
      "usage": "pressed icon/button, active filter chip, open segment tag",
      "derivedPerTheme": true
    },
    {
      "id": "button-hover-border",
      "space": "srgb",
      "from": "text",
      "weight": 0.3,
      "to": "line-strong",
      "usage": "button hover border",
      "derivedPerTheme": true
    },
    {
      "id": "segment-loss-border",
      "space": "srgb",
      "from": "refuse",
      "weight": 0.45,
      "to": "line",
      "usage": "loss segment tag border",
      "derivedPerTheme": true
    },
    {
      "id": "refuse-chip-border",
      "space": "srgb",
      "from": "refuse",
      "weight": 0.38,
      "to": "line",
      "usage": "refused-verb chip border",
      "derivedPerTheme": true
    },
    {
      "id": "theme-option-active-border",
      "space": "srgb",
      "from": "live",
      "weight": 0.55,
      "to": "line",
      "usage": "selected theme option border",
      "derivedPerTheme": true
    },
    {
      "id": "ledger-loss-hover-surface",
      "space": "srgb",
      "from": "refuse",
      "weight": 0.14,
      "to": "panel",
      "usage": "loss ledger row hover background",
      "derivedPerTheme": true
    }
  ],
